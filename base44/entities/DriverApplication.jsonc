{
  "name": "DriverApplication",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "city": {
      "type": "string"
    },
    "interested_in": {
      "type": "string",
      "enum": [
        "Uber",
        "Food Delivery",
        "Uber Eats"
      ]
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Neu",
        "Kontaktiert",
        "In Bearbeitung",
        "Abgeschlossen"
      ],
      "default": "Neu"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email",
    "phone"
  ]
}